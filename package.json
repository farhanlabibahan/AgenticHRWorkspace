{
  "name": "source-ats",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Open source Applicant Tracking System — Lever feature parity, built on Next.js + Neon + Vercel.",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && node scripts/migrate.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "studio": "prisma studio",
    "postinstall": "prisma generate",
    "import-org": "node scripts/import-org.mjs",
    "seed:scale": "node --env-file-if-exists=.env scripts/seed-scale.mjs",
    "import-lever": "node scripts/import-lever.mjs",
    "import-greenhouse": "node scripts/import-greenhouse.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@prisma/client": "^6.7.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@tanstack/react-virtual": "^3.14.13",
    "@tesseract.js-data/eng": "1.0.0",
    "@vercel/blob": "^2.6.1",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.3",
    "bot-avatars": "0.1.1",
    "clsx": "^2.1.1",
    "eslint-config-next": "^16.3.6",
    "lucide-react": "^0.525.0",
    "next": "^16.3.6",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^7.0.13",
    "pdfjs-dist": "6.1.200",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.3.1",
    "tesseract.js": "7.0.0",
    "undici": "^6.28.1",
    "unpdf": "1.8.1",
    "word-extractor": "1.0.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.1.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dialkit": "^2.0.2",
    "motion": "^13.4.3",
    "playwright-core": "^1.61.1",
    "prisma": "^6.7.0",
    "storybook": "10.6.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^5",
    "vite": "7.3.6",
    "vitest": "^3.2.7"
  }
}
