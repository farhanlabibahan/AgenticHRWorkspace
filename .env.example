# Neon Postgres — pooled connection string (used by the app at runtime)
# Get both from the Neon dashboard → Connection Details
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/openats?sslmode=require"

# Neon direct (non-pooled) connection — used by Prisma for migrations
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/openats?sslmode=require"

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="change-me"

# Set to true when running behind a proxy / outside Vercel (e.g. next start, Docker)
# AUTH_TRUST_HOST=true

# "Continue with Google" on sign-in and sign-up. Optional: unset, the button
# isn't shown and nothing mentions Google. Create your own OAuth client
# (full steps in the README, "Sign in with Google"):
#   console.cloud.google.com → Google Auth Platform → Get started (consent
#   screen) → Clients → Create client → Web application, with
#   Authorized JavaScript origins:  https://your-domain   http://localhost:3000
#   Authorized redirect URIs:       https://your-domain/api/auth/callback/google
#                                   http://localhost:3000/api/auth/callback/google
#   Copy the secret at once: Google shows it only when the client is created.
# AUTH_GOOGLE_ID="1234567890-abc123.apps.googleusercontent.com"
# AUTH_GOOGLE_SECRET="GOCSPX-..."

# Email delivery — any SMTP provider (SES, Postmark, Resend SMTP…).
# Leave unset in dev: emails are logged and marked sent without leaving the box.
# SMTP_URL="smtp://user:pass@smtp.example.com:587"
# EMAIL_FROM="Acme Recruiting <careers@acme.com>"

# Protects /api/cron/* (Vercel Cron sends it automatically when set)
# CRON_SECRET="change-me"

# ATS imports (Settings → Import) seal vendor API keys with a key derived
# from this, falling back to AUTH_SECRET. Keys are deleted when the import ends.
# IMPORT_ENCRYPTION_KEY="change-me"

# File storage (resumes, attachments, logos). Pick one; unset = local
# .data/uploads, which works in dev and Docker (mount .data as a volume)
# but not on Vercel, whose disk doesn't persist.
#
# Recommended: any S3-compatible bucket, kept private — Source serves files
# through /api/files. Cloudflare R2 has no egress fees and a 10 GB free tier:
#   R2 dashboard → Create bucket → Manage API tokens → Create API token
#   (Object Read & Write, scoped to the bucket), then:
# S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# S3_BUCKET="source-files"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_REGION="auto"            # R2: auto. B2/S3/MinIO: the bucket's region
# (Backblaze B2: https://s3.<region>.backblazeb2.com; MinIO: http://minio:9000)
#
# Or Vercel Blob:
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Resume text extraction runs in a worker thread, so a hostile file can be
# killed on a timeout or memory limit. Set to 0 to extract in-process instead
# (an escape hatch if threads misbehave on your platform). That removes the
# protection: a malicious upload from the careers page can then stall or
# crash the server.
# TEXT_EXTRACT_WORKER=0

# Demo mode — shows a one-click "Explore the demo" button on / and /login
# that seeds an isolated sample org and signs you in (password rotates on
# every use). Always on in dev; set to 1 to enable on a deployed instance.
# DEMO_MODE=1

# OCR for scanned resumes (/api/cron/ocr): Tesseract, in-process, no key.
# Languages as Tesseract codes joined with "+". Each one is a package:
# npm install @tesseract.js-data/fra@1.0.0, then set this before building so
# the build ships its data. Default: eng.
# OCR_LANGS=eng+fra

# Resume parsing: fills empty candidate fields (headline, location, phone,
# links) and a structured profile from NEW applicants' resumes, in the
# background. Off until one of these is set. The resume's extracted text is
# sent to the provider you configure; see docs/resume-parsing.md.
# Groq (OpenAI's gpt-oss-20b by default); create a key at https://console.groq.com/keys
# GROQ_API_KEY=""
# RESUME_PARSER_MODEL=openai/gpt-oss-120b     # bigger, about 2x the price
# Or any OpenAI-compatible endpoint, including Ollama on your own server:
# RESUME_PARSER_BASE_URL=http://localhost:11434/v1
# RESUME_PARSER_API_KEY=""                    # not needed for a local Ollama
# RESUME_PARSER_TIMEOUT_MS=20000              # use 120000 for a local model
# RESUME_PARSER_DAILY_LIMIT=500               # per organization per UTC day; 0 pauses
# RESUME_PARSER_GLOBAL_DAILY_LIMIT=           # across all organizations; unset = none
# RESUME_PARSER_EXCLUDE_ORGS=                 # org ids or slugs never parsed, comma-separated
# RESUME_PARSER_MAX_CHARS=12000
# RESUME_PARSER=off                           # turn it off without removing the key

# Company and school logos on candidate profiles (experience, education),
# looked up by name at Logo.dev. A publishable key (pk_...), meant for the
# browser, so NEXT_PUBLIC_ is right. Company names go to Logo.dev from the
# viewer's browser. Unset = name-seeded orbs; nothing is sent anywhere.
# The free plan asks for the "Logos provided by Logo.dev" link the profile shows.
# NEXT_PUBLIC_LOGO_DEV_TOKEN=""

# AI: candidate evaluations, role criteria, Ask AI and interview insights.
# The core calls no model: it sends the material to an
# AI provider over the protocol in docs/ai-protocol.md (Source ATS runs one,
# or run your own). Configured here, never in the app; unset = those
# features don't appear and nothing is sent anywhere. Separate from resume
# parsing's GROQ_API_KEY.
# AI_SERVICE_URL=https://ai.example.com
# AI_SERVICE_TOKEN=""
# AI_PROVIDER=mock                              # deterministic offline provider for dev/tests
